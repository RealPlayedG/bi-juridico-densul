# Copie para ".env" para rodar no computador. Nunca envie o .env para o GitHub.
SECRET_KEY=
# Senha do primeiro acesso de todo usuário novo (cada um cria a sua em seguida)
SENHA_PADRAO=
# Usuário administrador criado na primeira vez que o sistema sobe
ADMIN_USUARIO=admin
ADMIN_NOME=Administrador
# Banco: no Railway vem do Postgres (${{Postgres.DATABASE_URL}}). Vazio = SQLite local em data/local.db
DATABASE_URL=
# Pasta dos anexos e backups (no Railway: volume montado em /data)
PASTA_DADOS=data
DIAS_BACKUP=60
# Em localhost (sem https) use 0
COOKIE_SEGURO=0
# Planilha espelho (cópia da planilha Jurídico que o sistema mantém atualizada)
ESPELHO_PLANILHA_ID=
GOOGLE_CREDENTIALS_JSON=
